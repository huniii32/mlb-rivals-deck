# 배포 도메인을 쉼표로 (예: deck.example.com)
WEB_ALLOWED_HOSTS=
# 같은 공유기에서 접속하려면 0.0.0.0
WEB_HOST=127.0.0.1
WEB_PORT=5176
# Supabase 연동 (없으면 로컬 모드로 동작)
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx (또는 eyJ... anon key)

# Cloudflare Pages: NODE_VERSION=22, npm run build:cloudflare, output=dist
# 위 Supabase 변수 2개를 Cloudflare 빌드 환경에도 설정해야 합니다.
# build:cloudflare는 루트 경로 / 를 사용합니다. 기존 GitHub Pages는 /mlb-rivals-deck/ 입니다.
# 이전 절차와 브라우저 데이터 백업: docs/cloudflare-migration.md
